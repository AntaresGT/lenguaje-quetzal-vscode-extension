{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Quetzal",
    "scopeName": "source.quetzal",
    "patterns": [
        {
            "include": "#comentarios"
        },
        {
            "include": "#cadenas"
        },
        {
            "include": "#numeros"
        },
        {
            "include": "#palabras_reservadas"
        },
        {
            "include": "#tipos_datos"
        },
        {
            "include": "#operadores"
        },
        {
            "include": "#funciones"
        },
        {
            "include": "#variables"
        },
        {
            "include": "#objetos"
        },
        {
            "include": "#llaves_corchetes"
        }
    ],
    "repository": {
        "comentarios": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.quetzal",
                    "match": "//.*$"
                },
                {
                    "name": "comment.block.quetzal",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "cadenas": {
            "patterns": [
                {
                    "name": "string.interpolated.quetzal",
                    "begin": "t\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.quetzal",
                            "match": "\\\\."
                        },
                        {
                            "name": "meta.interpolation.quetzal",
                            "begin": "\\{",
                            "end": "\\}",
                            "beginCaptures": {
                                "0": {
                                    "name": "punctuation.definition.interpolation.begin.quetzal"
                                }
                            },
                            "endCaptures": {
                                "0": {
                                    "name": "punctuation.definition.interpolation.end.quetzal"
                                }
                            },
                            "patterns": [
                                {
                                    "include": "source.quetzal"
                                }
                            ]
                        }
                    ]
                },
                {
                    "name": "string.quoted.double.quetzal",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.quetzal",
                            "match": "\\\\."
                        }
                    ]
                },
                {
                    "name": "string.quoted.single.quetzal",
                    "begin": "'",
                    "end": "'",
                    "patterns": [
                        {
                            "name": "constant.character.escape.quetzal",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },
        "numeros": {
            "patterns": [
                {
                    "name": "constant.numeric.float.quetzal",
                    "match": "\\b\\d+\\.\\d+\\b"
                },
                {
                    "name": "constant.numeric.integer.quetzal",
                    "match": "\\b\\d+\\b"
                }
            ]
        },
        "palabras_reservadas": {
            "patterns": [
                {
                    "name": "keyword.control.quetzal",
                    "match": "\\b(si|sino|mientras|para|en|cada|hacer|romper|continuar|retornar|intentar|capturar|atrapar|finalmente|lanzar)\\b"
                },
                {
                    "name": "keyword.other.quetzal",
                    "match": "\\b(importar|exportar|desde|como|nuevo|ambiente|libre|asíncrono|asincróno|asincrono|esperar)\\b"
                },
                {
                    "name": "keyword.operator.logical.quetzal",
                    "match": "\\b(y|o|ó)\\b"
                },
                {
                    "name": "storage.modifier.quetzal",
                    "match": "\\b(var|público|publico|privado)\\b"
                },
                {
                    "name": "storage.type.class.quetzal",
                    "match": "\\b(objeto|excepción|excepcion)\\b"
                }
            ]
        },
        "tipos_datos": {
            "patterns": [
                {
                    "name": "storage.type.quetzal",
                    "match": "\\b(vacío|vacio|entero|número|numero|texto|log|lóg|lista|jsn|excepción|excepcion)\\b"
                },
                {
                    "name": "constant.language.boolean.quetzal",
                    "match": "\\b(verdadero|falso)\\b"
                },
                {
                    "name": "constant.language.null.quetzal",
                    "match": "\\b(nulo)\\b"
                }
            ]
        },
        "operadores": {
            "patterns": [
                {
                    "name": "keyword.operator.assignment.quetzal",
                    "match": "(=|\\+=|-=|\\*=|/=|%=)"
                },
                {
                    "name": "keyword.operator.comparison.quetzal",
                    "match": "(==|!=|<=|>=|<|>)"
                },
                {
                    "name": "keyword.operator.arithmetic.quetzal",
                    "match": "(\\*\\*|\\+\\+|\\-\\-|\\+|\\-|\\*|/|%)"
                },
                {
                    "name": "keyword.operator.logical.quetzal",
                    "match": "(&&|\\|\\||!)"
                },
                {
                    "name": "keyword.operator.ternary.quetzal",
                    "match": "(\\?|:)"
                },
                {
                    "name": "keyword.operator.spread.quetzal",
                    "match": "\\.\\.\\."
                }
            ]
        },
        "funciones": {
            "patterns": [
                {
                    "name": "entity.name.function.definition.quetzal",
                    "match": "\\b(vacío|vacio|entero|número|numero|texto|log|lóg|lista|jsn|excepción|excepcion)\\s+([a-zA-ZáéíóúüñÁÉÍÓÚÜÑ_][a-zA-Z0-9áéíóúüñÁÉÍÓÚÜÑ_]*)\\s*(?=\\()",
                    "captures": {
                        "1": {
                            "name": "storage.type.quetzal"
                        },
                        "2": {
                            "name": "entity.name.function.quetzal"
                        }
                    }
                },
                {
                    "name": "support.function.builtin.quetzal",
                    "match": "\\b(rango)\\b"
                },
                {
                    "name": "support.class.builtin.quetzal",
                    "match": "\\b(consola|Matemática|Archivo|Red|Sistema)\\b"
                },
                {
                    "name": "entity.name.function.call.quetzal",
                    "match": "\\b([a-zA-ZáéíóúüñÁÉÍÓÚÜÑ_][a-zA-Z0-9áéíóúüñÁÉÍÓÚÜÑ_]*)\\s*(?=\\()",
                    "captures": {
                        "1": {
                            "name": "entity.name.function.quetzal"
                        }
                    }
                }
            ]
        },
        "variables": {
            "patterns": [
                {
                    "name": "variable.other.declaration.quetzal",
                    "match": "\\b(vacío|vacio|entero|número|numero|texto|log|lóg|lista|jsn|excepción|excepcion)\\s+(var\\s+)?([a-zA-ZáéíóúüñÁÉÍÓÚÜÑ_][a-zA-Z0-9áéíóúüñÁÉÍÓÚÜÑ_]*)\\s*(?==)",
                    "captures": {
                        "1": {
                            "name": "storage.type.quetzal"
                        },
                        "2": {
                            "name": "storage.modifier.quetzal"
                        },
                        "3": {
                            "name": "variable.other.quetzal"
                        }
                    }
                },
                {
                    "name": "variable.other.quetzal",
                    "match": "\\b[a-zA-ZáéíóúüñÁÉÍÓÚÜÑ_][a-zA-Z0-9áéíóúüñÁÉÍÓÚÜÑ_]*\\b"
                }
            ]
        },
        "objetos": {
            "patterns": [
                {
                    "name": "entity.name.type.class.quetzal",
                    "match": "\\b(objeto)\\s+([A-ZÁÉÍÓÚÜÑ][a-zA-Z0-9áéíóúüñÁÉÍÓÚÜÑ_]*)\\b",
                    "captures": {
                        "1": {
                            "name": "storage.type.class.quetzal"
                        },
                        "2": {
                            "name": "entity.name.type.quetzal"
                        }
                    }
                },
                {
                    "name": "entity.name.type.quetzal",
                    "match": "\\b[A-ZÁÉÍÓÚÜÑ][a-zA-Z0-9áéíóúüñÁÉÍÓÚÜÑ_]*\\b"
                }
            ]
        },
        "llaves_corchetes": {
            "patterns": [
                {
                    "name": "punctuation.definition.block.quetzal",
                    "match": "[{}]"
                },
                {
                    "name": "punctuation.definition.array.quetzal",
                    "match": "[\\[\\]]"
                },
                {
                    "name": "punctuation.definition.parameters.quetzal",
                    "match": "[()]"
                },
                {
                    "name": "punctuation.separator.quetzal",
                    "match": "[,.]"
                }
            ]
        }
    }
}
