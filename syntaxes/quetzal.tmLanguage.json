{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Quetzal",
    "scopeName": "source.quetzal",
    "patterns": [
        { "include": "#comentarios" },
        { "include": "#cadenas" },
        { "include": "#numeros" },
        { "include": "#palabras_reservadas" },
        { "include": "#tipos_datos" },
        { "include": "#objetos" },
        { "include": "#funciones" },
        { "include": "#variables" },
        { "include": "#operadores" },
        { "include": "#llaves_corchetes" }
    ],
    "repository": {
        "comentarios": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.quetzal",
                    "match": "//.*$"
                },
                {
                    "name": "comment.block.quetzal",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "cadenas": {
            "patterns": [
                {
                    "name": "string.template.quetzal",
                    "begin": "t\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.quetzal",
                            "match": "\\\\."
                        },
                        {
                            "name": "variable.other.placeholder.quetzal",
                            "match": "\\{[^}]*\\}"
                        }
                    ]
                },
                {
                    "name": "string.quoted.double.quetzal",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.quetzal",
                            "match": "\\\\."
                        },
                        {
                            "name": "variable.other.placeholder.quetzal",
                            "match": "\\{[^}]*\\}"
                        }
                    ]
                },
                {
                    "name": "string.quoted.single.quetzal",
                    "begin": "'",
                    "end": "'",
                    "patterns": [
                        {
                            "name": "constant.character.escape.quetzal",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },
        "numeros": {
            "patterns": [
                {
                    "name": "constant.numeric.float.quetzal",
                    "match": "\\b\\d+\\.\\d+\\b"
                },
                {
                    "name": "constant.numeric.integer.quetzal",
                    "match": "\\b\\d+\\b"
                }
            ]
        },
        "palabras_reservadas": {
            "patterns": [
                {
                    "name": "keyword.control.quetzal",
                    "match": "\\b(si|sino|mientras|para|hacer|romper|continuar|retornar|en|cada|intentar|capturar|finalmente|lanzar)\\b"
                },
                {
                    "name": "keyword.other.quetzal",
                    "match": "\\b(importar|exportar|desde|como|nuevo|esto|padre|libre|asincrono|asincróno|esperar|hereda|implementa|opcional|funcion|función|fn)\\b"
                },
                {
                    "name": "keyword.operator.logical.quetzal",
                    "match": "\\b(y|o|no)\\b"
                },
                {
                    "name": "storage.modifier.quetzal",
                    "match": "\\b(var|público|publico|privado)\\b"
                },
                {
                    "name": "storage.type.class.quetzal",
                    "match": "\\b(objeto|prototipo|excepción|excepcion)\\b"
                }
            ]
        },
        "tipos_datos": {
            "patterns": [
                {
                    "name": "storage.type.quetzal",
                    "match": "\\b(vacío|vacio|entero|número|numero|texto|log|lista|jsn|funcion)\\b"
                },
                {
                    "name": "constant.language.boolean.quetzal",
                    "match": "\\b(verdadero|falso)\\b"
                },
                {
                    "name": "constant.language.null.quetzal",
                    "match": "\\bnulo\\b"
                }
            ]
        },
        "objetos": {
            "patterns": [
                {
                    "name": "entity.name.type.class.quetzal",
                    "match": "\\b(objeto|prototipo)\\s+([A-Z][A-Za-z0-9_ÁÉÍÓÚáéíóúÑñ]*)\\b",
                    "captures": {
                        "1": { "name": "storage.type.class.quetzal" },
                        "2": { "name": "entity.name.type.quetzal" }
                    }
                },
                {
                    "name": "support.variable.builtin.quetzal",
                    "match": "\\bconsola\\b"
                },
                {
                    "name": "entity.name.type.quetzal",
                    "match": "\\b[A-Z][A-Za-z0-9_ÁÉÍÓÚáéíóúÑñ]*\\b"
                }
            ]
        },
        "funciones": {
            "patterns": [
                {
                    "name": "support.function.builtin.quetzal",
                    "match": "\\b(mostrar|mostrar_error|mostrar_advertencia|mostrar_informacion|mostrar_exito|pedir|pedir_secreto|rango)(?=\\s*\\()"
                },
                {
                    "name": "entity.name.function.definition.quetzal",
                    "match": "\\b(entero|número|numero|texto|log|lista|jsn|vacio|vacío|[A-Z][A-Za-z0-9_ÁÉÍÓÚáéíóúÑñ]*)\\s+(?:asincrono\\s+)?([A-Za-z_ÁÉÍÓÚáéíóúÑñ][A-Za-z0-9_ÁÉÍÓÚáéíóúÑñ]*)\\s*(?=\\()",
                    "captures": {
                        "1": { "name": "storage.type.quetzal" },
                        "2": { "name": "entity.name.function.quetzal" }
                    }
                },
                {
                    "name": "entity.name.function.definition.legacy.quetzal",
                    "match": "\\b(función|funcion|fn)\\s+([A-Za-z_ÁÉÍÓÚáéíóúÑñ][A-Za-z0-9_ÁÉÍÓÚáéíóúÑñ]*)\\b",
                    "captures": {
                        "1": { "name": "keyword.other.quetzal" },
                        "2": { "name": "entity.name.function.quetzal" }
                    }
                },
                {
                    "name": "entity.name.function.call.quetzal",
                    "match": "\\b([A-Za-z_ÁÉÍÓÚáéíóúÑñ][A-Za-z0-9_ÁÉÍÓÚáéíóúÑñ]*)\\s*(?=\\()",
                    "captures": {
                        "1": { "name": "entity.name.function.quetzal" }
                    }
                }
            ]
        },
        "variables": {
            "patterns": [
                {
                    "name": "variable.other.declaration.quetzal",
                    "match": "\\b(entero|número|numero|texto|log|lista|jsn|vacio|vacío|[A-Z][A-Za-z0-9_ÁÉÍÓÚáéíóúÑñ]*)\\s+(var\\s+)?([A-Za-z_ÁÉÍÓÚáéíóúÑñ][A-Za-z0-9_ÁÉÍÓÚáéíóúÑñ]*)\\s*(?==)",
                    "captures": {
                        "1": { "name": "storage.type.quetzal" },
                        "2": { "name": "storage.modifier.quetzal" },
                        "3": { "name": "variable.other.quetzal" }
                    }
                },
                {
                    "name": "variable.other.quetzal",
                    "match": "\\b[A-Za-z_ÁÉÍÓÚáéíóúÑñ][A-Za-z0-9_ÁÉÍÓÚáéíóúÑñ]*\\b"
                }
            ]
        },
        "operadores": {
            "patterns": [
                {
                    "name": "keyword.operator.assignment.quetzal",
                    "match": "(=|\\+=|-=|\\*=|/=|%=)"
                },
                {
                    "name": "keyword.operator.comparison.quetzal",
                    "match": "(==|!=|<=|>=|<|>)"
                },
                {
                    "name": "keyword.operator.arithmetic.quetzal",
                    "match": "(\\+\\+|--|\\+|\\-|\\*|/|%)"
                },
                {
                    "name": "keyword.operator.logical.quetzal",
                    "match": "(&&|\\|\\||!)"
                },
                {
                    "name": "keyword.operator.ternary.quetzal",
                    "match": "(\\?|:)"
                },
                {
                    "name": "keyword.operator.spread.quetzal",
                    "match": "\\.\\.\\."
                }
            ]
        },
        "llaves_corchetes": {
            "patterns": [
                {
                    "name": "punctuation.definition.block.quetzal",
                    "match": "[{}]"
                },
                {
                    "name": "punctuation.definition.array.quetzal",
                    "match": "[\\[\\]]"
                },
                {
                    "name": "punctuation.definition.parameters.quetzal",
                    "match": "[()]"
                },
                {
                    "name": "punctuation.separator.quetzal",
                    "match": "[,;.]"
                }
            ]
        }
    }
}
