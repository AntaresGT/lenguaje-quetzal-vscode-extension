{
    "Función básica": {
        "prefix": "funcion",
        "body": [
            "${1:tipo} ${2:nombreFuncion}(${3:parametros}) {",
            "\t${4:// Código de la función}",
            "\tretornar ${5:valor}",
            "}"
        ],
        "description": "Crear una función básica en Quetzal"
    },
    "Función básica snake_case": {
        "prefix": "funcion_snake",
        "body": [
            "${1:tipo} ${2:nombre_funcion}(${3:parametros}) {",
            "\t${4:// Código de la función}",
            "\tretornar ${5:valor}",
            "}"
        ],
        "description": "Crear una función básica en snake_case"
    },
    "Función sin retorno": {
        "prefix": "funcion_vacia",
        "body": [
            "vacio ${1:nombreFuncion}(${2:parametros}) {",
            "\t${3:// Código de la función}",
            "}"
        ],
        "description": "Crear una función sin valor de retorno"
    },
    "Función sin retorno snake_case": {
        "prefix": "funcion_vacia_snake",
        "body": [
            "vacio ${1:nombre_funcion}(${2:parametros}) {",
            "\t${3:// Código de la función}",
            "}"
        ],
        "description": "Crear una función sin valor de retorno en snake_case"
    },
    "Función asíncrona": {
        "prefix": "asincrono",
        "body": [
            "asincrono ${1:tipo} ${2:nombre_funcion}(${3:parametros}) {",
            "\t${4:// Código de la función asíncrona}",
            "\tretornar ${5:valor}",
            "}"
        ],
        "description": "Crear una función asíncrona en Quetzal"
    },
    "Declarar variable constante": {
        "prefix": "const",
        "body": [
            "${1|entero,número,texto,log,lista,jsn|} ${2:nombre_variable} = ${3:valor}"
        ],
        "description": "Declarar una variable constante (inmutable por defecto)"
    },
    "Declarar variable mutable": {
        "prefix": "var",
        "body": [
            "${1|entero,número,texto,log,lista,jsn|} var ${2:nombre_variable} = ${3:valor}"
        ],
        "description": "Declarar una variable mutable con var"
    },
    "Declarar variable mutable snake_case": {
        "prefix": "var_snake",
        "body": [
            "${1|entero,número,texto,log,lista,jsn|} var ${2:nombre_variable} = ${3:valor}"
        ],
        "description": "Declarar una variable mutable en snake_case"
    },
    "Consola mostrar": {
        "prefix": "mostrar",
        "body": [
            "consola.mostrar(${1:\"mensaje\"})"
        ],
        "description": "Mostrar un mensaje en consola"
    },
    "Consola mostrar éxito": {
        "prefix": "mostrar_exito",
        "body": [
            "consola.mostrar_exito(${1:\"mensaje de éxito\"})"
        ],
        "description": "Mostrar un mensaje de éxito (verde)"
    },
    "Consola mostrar error": {
        "prefix": "mostrar_error",
        "body": [
            "consola.mostrar_error(${1:\"mensaje de error\"})"
        ],
        "description": "Mostrar un mensaje de error (rojo)"
    },
    "Consola mostrar advertencia": {
        "prefix": "mostrar_advertencia",
        "body": [
            "consola.mostrar_advertencia(${1:\"mensaje de advertencia\"})"
        ],
        "description": "Mostrar un mensaje de advertencia (amarillo)"
    },
    "Consola mostrar información": {
        "prefix": "mostrar_informacion",
        "body": [
            "consola.mostrar_informacion(${1:\"mensaje informativo\"})"
        ],
        "description": "Mostrar un mensaje informativo (azul)"
    },
    "Consola pedir entrada": {
        "prefix": "pedir",
        "body": [
            "texto ${1:respuesta} = consola.pedir(${2:\"Ingresa un valor: \"})"
        ],
        "description": "Pedir entrada de texto al usuario"
    },
    "Consola pedir secreto": {
        "prefix": "pedir_secreto",
        "body": [
            "texto ${1:clave} = consola.pedir_secreto(${2:\"Ingresa tu contraseña: \"})"
        ],
        "description": "Pedir entrada secreta al usuario (no visible)"
    },
    "Condicional si": {
        "prefix": "si",
        "body": [
            "si (${1:condición}) {",
            "\t${2:// Código si es verdadero}",
            "}"
        ],
        "description": "Crear un condicional si"
    },
    "Condicional si-sino": {
        "prefix": "si_sino",
        "body": [
            "si (${1:condición}) {",
            "\t${2:// Código si es verdadero}",
            "} sino {",
            "\t${3:// Código si es falso}",
            "}"
        ],
        "description": "Crear un condicional si-sino"
    },
    "Condicional si-sino si-sino": {
        "prefix": "si_sino_si",
        "body": [
            "si (${1:condición1}) {",
            "\t${2:// Código si condición1 es verdadero}",
            "} sino si (${3:condición2}) {",
            "\t${4:// Código si condición2 es verdadero}",
            "} sino {",
            "\t${5:// Código si ninguna condición es verdadera}",
            "}"
        ],
        "description": "Crear un condicional si-sino si-sino"
    },
    "Bucle mientras": {
        "prefix": "mientras",
        "body": [
            "mientras (${1:condición}) {",
            "\t${2:// Código del bucle}",
            "}"
        ],
        "description": "Crear un bucle mientras"
    },
    "Bucle para": {
        "prefix": "para",
        "body": [
            "para (entero var ${1:i} = ${2:0}; ${1:i} < ${3:10}; ${1:i}++) {",
            "\t${4:// Código del bucle}",
            "}"
        ],
        "description": "Crear un bucle para con sintaxis completa"
    },
    "Bucle para-en": {
        "prefix": "para_en",
        "body": [
            "para (${1|entero,número,texto,log|} var ${2:elemento} en ${3:lista}) {",
            "\t${4:// Código del bucle}",
            "}"
        ],
        "description": "Crear un bucle para-en (foreach)"
    },
    "Bucle para-cada": {
        "prefix": "para_cada",
        "body": [
            "para (${1|entero,número,texto,log|} var ${2:elemento} cada ${3:lista}) {",
            "\t${4:// Código del bucle}",
            "}"
        ],
        "description": "Crear un bucle para-cada (alternativa a foreach)"
    },
    "Bucle hacer-mientras": {
        "prefix": "hacer",
        "body": [
            "hacer {",
            "\t${1:// Código del bucle}",
            "} mientras (${2:condición})"
        ],
        "description": "Crear un bucle hacer-mientras"
    },
    "Objeto": {
        "prefix": "objeto",
        "body": [
            "objeto ${1:NombreObjeto} {",
            "\tprivado:",
            "\t\t${2|entero,número,texto,log|} var ${3:propiedad}",
            "",
            "\tpublico:",
            "\t\t${1:NombreObjeto}(${4:parametros}) {",
            "\t\t\t${5:// Constructor}",
            "\t\t}",
            "",
            "\t\t${6|entero,número,texto,log,vacio|} ${7:metodo}() {",
            "\t\t\t${8:// Método}",
            "\t\t}",
            "}"
        ],
        "description": "Crear un objeto con propiedades públicas y privadas"
    },
    "Objeto simple": {
        "prefix": "objeto_simple",
        "body": [
            "objeto ${1:NombreObjeto} {",
            "\t${2|entero,número,texto,log|} var ${3:propiedad}",
            "",
            "\t${1:NombreObjeto}(${4:parametros}) {",
            "\t\t${5:// Constructor}",
            "\t}",
            "}"
        ],
        "description": "Crear un objeto simple (público por defecto)"
    },
    "JSON": {
        "prefix": "jsn",
        "body": [
            "jsn ${1:nombre_json} = {",
            "\t${2:clave}: \"${3:valor}\",",
            "\t${4:otra_clave}: ${5:otro_valor}",
            "}"
        ],
        "description": "Crear un objeto JSON"
    },
    "JSON mutable": {
        "prefix": "jsn_var",
        "body": [
            "jsn var ${1:nombre_json} = {",
            "\t${2:clave}: \"${3:valor}\",",
            "\t${4:otra_clave}: ${5:otro_valor}",
            "}"
        ],
        "description": "Crear un objeto JSON mutable"
    },
    "Lista": {
        "prefix": "lista",
        "body": [
            "lista<${1|entero,número,texto,log|}> ${2:nombre_lista} = [${3:valores}]"
        ],
        "description": "Crear una lista tipada"
    },
    "Lista mutable": {
        "prefix": "lista_var",
        "body": [
            "lista<${1|entero,número,texto,log|}> var ${2:nombre_lista} = [${3:valores}]"
        ],
        "description": "Crear una lista tipada mutable"
    },
    "Rango de números": {
        "prefix": "rango",
        "body": [
            "lista ${1:numeros} = rango(${2:1}, ${3:10})"
        ],
        "description": "Crear una lista con rango de números consecutivos"
    },
    "Intentar-Capturar": {
        "prefix": "intentar",
        "body": [
            "intentar {",
            "\t${1:// Código que puede fallar}",
            "} capturar (excepcion ${2:e}) {",
            "\t${3:// Manejo de la excepción}",
            "\tconsola.mostrar_error(${2:e}.mensaje)",
            "}"
        ],
        "description": "Bloque intentar-capturar"
    },
    "Intentar-Capturar-Finalmente": {
        "prefix": "intentar_finalmente",
        "body": [
            "intentar {",
            "\t${1:// Código que puede fallar}",
            "} capturar (excepcion ${2:e}) {",
            "\t${3:// Manejo de la excepción}",
            "\tconsola.mostrar_error(${2:e}.mensaje)",
            "} finalmente {",
            "\t${4:// Código que siempre se ejecuta}",
            "}"
        ],
        "description": "Bloque intentar-capturar-finalmente"
    },
    "Lanzar excepción": {
        "prefix": "lanzar",
        "body": [
            "lanzar \"${1:Mensaje de error}\""
        ],
        "description": "Lanzar una excepción"
    },
    "Importar": {
        "prefix": "importar",
        "body": [
            "importar {",
            "\t${1:elemento}",
            "} desde \"${2:ruta/al/modulo.qz}\""
        ],
        "description": "Importar módulo"
    },
    "Importar con alias": {
        "prefix": "importar_como",
        "body": [
            "importar {",
            "\t${1:elemento} como ${2:alias}",
            "} desde \"${3:ruta/al/modulo.qz}\""
        ],
        "description": "Importar módulo con alias"
    },
    "Importar Matemática": {
        "prefix": "importar_mate",
        "body": [
            "importar { Matemática } desde \"quetzal/matemática\""
        ],
        "description": "Importar módulo nativo de Matemáticas"
    },
    "Exportar": {
        "prefix": "exportar",
        "body": [
            "exportar {",
            "\t${1:elemento}",
            "}"
        ],
        "description": "Exportar elementos del módulo"
    },
    "Interpolación de texto": {
        "prefix": "t\"",
        "body": [
            "t\"${1:texto} {${2:variable}} ${3:más texto}\""
        ],
        "description": "Crear texto con interpolación de variables"
    },
    "Texto interpolado": {
        "prefix": "texto_interpolado",
        "body": [
            "texto ${1:mensaje} = t\"${2:Hola}, {${3:nombre}}!\""
        ],
        "description": "Declarar texto con interpolación"
    },
    "Comentario de bloque": {
        "prefix": "/*",
        "body": [
            "/*",
            " * ${1:Descripción del bloque}",
            " */"
        ],
        "description": "Comentario multilínea"
    },
    "Nuevo objeto": {
        "prefix": "nuevo",
        "body": [
            "${1:NombreObjeto} ${2:instancia} = nuevo ${1:NombreObjeto}(${3:parametros})"
        ],
        "description": "Instanciar un nuevo objeto"
    },
    "Método libre": {
        "prefix": "libre",
        "body": [
            "libre ${1|entero,número,texto,log,vacio|} ${2:nombre_metodo}(${3:parametros}) {",
            "\t${4:// Código del método}",
            "}"
        ],
        "description": "Crear un método libre (estático)"
    },
    "Ambiente": {
        "prefix": "ambiente",
        "body": [
            "ambiente.${1:propiedad}"
        ],
        "description": "Referencia al objeto actual (this)"
    },
    "Operador ternario": {
        "prefix": "ternario",
        "body": [
            "${1:condición} ? ${2:valor_verdadero} : ${3:valor_falso}"
        ],
        "description": "Operador ternario condicional"
    }
}
